def check_nr_in_fov(PKG,nas_path,recipe):
    global FOV_x
    global FOV_y
    global computer_name1
    global fail_item12
    handler_file = recipe + '.han'
    cmp_file = recipe + '.cmp'
    pitch_duan,pitch_chang,bot_number,nr_of_rows = get_handler(nas_path,handler_file) #获取tray pitch & bottom检测颗数 & 行数
    body_size_x,body_size_y = get_body_size(nas_path,cmp_file) #获取body size
    int_thickness,int_Z_stroke1,int_Z_stroke2 = get_Z_stroke(nas_path,handler_file) #获取Z_stroke信息，用来判断轨道
    
    if pitch_duan == 0 or pitch_chang == 0 or bot_number == 0 or nr_of_rows == 0 or body_size_x == 0 or body_size_y == 0:
        fail_item12 = fail_item12 + '检测颗数取值异常，请反馈叶智荃检查代码；'
        return int_thickness,int_Z_stroke1,int_Z_stroke2,body_size_x,body_size_y
    keshu_col = int(bot_number) / int(nr_of_rows) #X方向吸料颗数

    if PKG == 'LGA' or PKG == 'QFN' :
        FOV_x = 58000
    else:
        FOV_x = 60000

    actual_x_add = int(keshu_col) * int(pitch_duan) + float(body_size_x) # X方向多吸一颗料时X方向总长
    if actual_x_add < FOV_x :
        fail_item12 = fail_item12 + '背面X方向检测颗数设定异常;'
    
    if nr_of_rows == '1' and int(pitch_duan) <= 16000 :
        actual_y_add = int(pitch_chang) + float(body_size_y) # Y方向多吸一颗料时Y方向总长
        if actual_y_add < FOV_y:
            fail_item12 = fail_item12 + '背面Y方向检测颗数设定异常;'
    return int_thickness,int_Z_stroke1,int_Z_stroke2,body_size_x,body_size_y

