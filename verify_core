    for line_number, line_han in enumerate(content_han, start=1): 
        if 'component_thickness' in line_han:
            thickness = re.findall(r'\d+', line_han)
            int_thickness = [int(item) for item in thickness] ##int_thickness[0]
        if '[Z_stroke]' in line_han:
