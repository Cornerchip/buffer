
import threading
import datetime
import time
import os
import logging
import socket
from flask import Flask, request, jsonify
import verify_core  # 你的核心逻辑

# =========================
# 初始化
# =========================
app = Flask(__name__)
task_lock = threading.Lock()
running = False
last_result = None
last_message = ""
last_run_time = None
hostname = socket.gethostname()


# =========================
# 日志系统
# =========================
def init_log():
    if not os.path.exists("log"):
        os.makedirs("log")
    logname = datetime.datetime.now().strftime("%Y%m%d") + ".log"
    logging.basicConfig(
        filename=os.path.join("log", logname),
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s"
    )


# =========================
# API接口
# =========================

@app.route("/ping")
def ping():
    return {"status": "ok", "host": hostname}


@app.route("/status")
def status():
    return {
        "running": running,
        "last_result": last_result,
        "last_message": last_message,
        "last_run_time": last_run_time,
        "host": hostname
    }


@app.route("/run", methods=["POST"])
def run():
    global running, last_result, last_message, last_run_time

    if running:
        return jsonify({"result": False, "message": "task already running", "host": hostname})

    data = request.get_json()
    if not data:
        return jsonify({"result": False, "message": "invalid JSON"})

    logging.info("Received /run request: %s", data)

    # ======================
    # 根据 JSON 字段判断调用任务
    # ======================
    with task_lock:
        running = True
        last_run_time = str(datetime.datetime.now())

        try:
            # JSON1 示例 {"device":"1","mode":"3"}
            if "mode" in data:
                result, message = verify_core.verify_server_local()
            # JSON2 示例 {"device":"2","alarm":"4"}
            elif "alarm" in data:
                result, message = verify_core.verify_server_local_type2()
            else:
                running = False
                return jsonify({"result": False, "message": "unknown JSON format", "host": hostname})

            # 返回原 JSON 并加 result
            response = data.copy()
            response["result"] = result
            if not result:
                response["message"] = message

            last_result = result
            last_message = message

        except Exception as e:
            result = False
            message = str(e)
            last_result = result
            last_message = message
            response = data.copy()
            response["result"] = result
            response["message"] = message
            logging.error("Exception in task: %s", e)

        finally:
            running = False

    return jsonify(response)


# =========================
# 主程序
# =========================
if __name__ == "__main__":
    init_log()
    logging.info("AOI SERVICE START")
    print("AOI SERVICE START")
    print("API: http://0.0.0.0:5000")

    # Flask在子线程运行
    def flask_thread():
        app.run(host="0.0.0.0", port=5000, threaded=True, debug=False)

    t = threading.Thread(target=flask_thread)
    t.daemon = True
    t.start()

    # 主线程阻塞，保持exe长期运行
    while True:
        time.sleep(60)
