
def run():
    data = request.get_json()
    if not data:
        return jsonify({"result": False, "message": "invalid JSON"})

    logging.info("Received /run request: %s", data)

    # 判断任务类型
    if "mode" in data:
        # JSON1 -> 触发任务A
        try:
            result, message = verify_core.verify_server_local()
        except Exception as e:
            result = False
            message = str(e)
    elif "alarm" in data:
        # JSON2 -> 触发任务B
        try:
            result, message = verify_core.verify_server_local_type2()
        except Exception as e:
            result = False
            message = str(e)
    else:
        return jsonify({"result": False, "message": "unknown JSON format"})

    # 返回原 JSON，并加 result 字段
    response = data.copy()
    response["result"] = result  # 这里 result 来自 verify_core
    if not result:
        response["message"] = message  # 失败时返回 message
    return jsonify(response)
