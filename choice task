
def run():
    global running

    if running:
        return jsonify({
            "result": False,
            "message": "task already running",
            "host": hostname
        })

    data = request.get_json()
    if not data:
        return jsonify({
            "result": False,
            "message": "invalid JSON",
            "host": hostname
        })

    logging.info("Received /run request: %s", data)

    # 判断任务类型
    if "mode" in data:
        task_func = run_task_A
    elif "alarm" in data:
        task_func = run_task_B
    else:
        return jsonify({
            "result": False,
            "message": "unknown JSON format",
            "host": hostname
        })

    # 异步执行任务
    t = threading.Thread(target=task_func)
    t.daemon = True
    t.start()

    # 返回原 JSON，加上 result 字段
    response = data.copy()  # 避免修改原数据
    response["result"] = True
    return jsonify(response)
